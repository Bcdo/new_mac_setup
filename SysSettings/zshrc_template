# ~/.zshrc - Zsh configuration
# Generated by new_mac_setup

# ========================
# ENVIRONMENT VARIABLES
# ========================

# Set default editor
export EDITOR="code"
export VISUAL="code"

# Homebrew configuration
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1

# Add common paths
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

# Node.js and Bun
export PATH="$HOME/.bun/bin:$PATH"

# Python
export PATH="/opt/homebrew/opt/python@3.12/bin:$PATH"

# ========================
# ALIASES - GENERAL
# ========================

# Enhanced ls commands
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ls='ls -G'  # Enable colors on macOS

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias -- -='cd -'

# File operations
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'
alias mkdir='mkdir -pv'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Shortcuts
alias h='history'
alias c='clear'
alias reload='source ~/.zshrc'
alias path='echo -e ${PATH//:/\\n}'

# ========================
# ALIASES - DEVELOPMENT
# ========================

# Git shortcuts
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'
alias gd='git diff'
alias gb='git branch'
alias gsb='git switch'
alias gco='git checkout'
alias gpull='git pull'

# GitHub CLI shortcuts
alias ghweb='gh repo view --web'
alias ghissues='gh issue list'
alias ghpr='gh pr list'
alias ghi='gh issue create'

# Python shortcuts
alias py='python3'
alias pip='pip3'
alias venv='python3 -m venv'

# Node.js and universal package manager (ni)
# ni automatically detects package manager from lockfiles (npm, yarn, pnpm, bun)
# ni = install, nr = run, nlx = exec, nu = upgrade, nci = clean install
alias serve='python3 -m http.server'

# Web development
alias ports='lsof -i -P -n | grep LISTEN'

# ========================
# ALIASES - SYSTEM
# ========================

# System information
alias cpu='top -o cpu'
alias mem='top -o mem'
alias df='df -H'
alias du='du -ch'
alias free='vm_stat'

# Network
alias myip='curl -s ifconfig.me'
alias localip='ipconfig getifaddr en0'
alias netstat='netstat -tuln'
alias ping='ping -c 5'

# macOS specific
alias show='defaults write com.apple.finder AppleShowAllFiles YES && killall Finder'
alias hide='defaults write com.apple.finder AppleShowAllFiles NO && killall Finder'
alias cleanup='sudo rm -rf /tmp/* && sudo rm -rf ~/.Trash/*'
alias update='brew update && brew upgrade && brew cleanup'

# ========================
# FUNCTIONS
# ========================

# Create directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Go directly to folder on path
cdm() {
    if [[-z "$1" ]]; then
        echo "Please provide a folder name"
        return 1
    fi
    curr_path=$(pwd)
    folders=(${(s/:/)curr_path})
    for ((i=${#folders[@]}; i>0; i--)); do
        if [[ "${folders[i-1]}" == "$1" ]]; then
            cd_path="/$(IFS=/; echo "${folders[1,i]}")"
            cd "$cd_path" || echo "Failed to change directory to $cd_path"
            return 0
        fi
    done
    echo "Folder '$1' not found in path"
    return 1
}

# Extract various archive formats
extract() {
    if [ -f $1 ]; then
        case $1 in
            *.tar.bz2)   tar xvjf $1    ;;
            *.tar.gz)    tar xvzf $1    ;;
            *.bz2)       bunzip2 $1     ;;
            *.rar)       rar x $1       ;;
            *.gz)        gunzip $1      ;;
            *.tar)       tar xvf $1     ;;
            *.tbz2)      tar xvjf $1    ;;
            *.tgz)       tar xvzf $1    ;;
            *.zip)       unzip $1       ;;
            *.Z)         uncompress $1  ;;
            *.7z)        7z x $1        ;;
            *)           echo "don't know how to extract '$1'..." ;;
        esac
    else
        echo "'$1' is not a valid file!"
    fi
}

# Find files by name
ff() {
    find . -name "*$1*" 2>/dev/null
}

# Search for text in files
ftext() {
    grep -r --include="*.$2" "$1" .
}

# Git commit with message
gcommit() {
    git add .
    git commit -m "$1"
}

# Quick project setup
project() {
    mkcd "$1"
    git init
    touch README.md
    echo "# $1" > README.md
    echo "Created new project: $1"
}

# Weather check
weather() {
    curl -s "wttr.in/$1?format=3"
}


# ========================
# ZSH CONFIGURATION
# ========================

# History settings
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_VERIFY
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE

# Auto-completion
autoload -U compinit
compinit

# Case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Colored completion
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Auto-correction disabled - Warp Terminal handles suggestions better

# Directory options
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS

# ========================
# TOOL INTEGRATIONS
# ========================

# Bun completions (if installed)
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# GitHub CLI completions (if installed)
command -v gh >/dev/null 2>&1 && eval "$(gh completion -s zsh)"

# Load local customizations if they exist
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# Welcome message
echo "🚀 Welcome to your new Mac setup!"
echo "Type 'reload' to refresh this configuration"
